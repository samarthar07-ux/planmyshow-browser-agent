{
  "manifest_version": 3,
  "name": "Plan my Show – Booking Decision Assistant",
  "version": "0.1.0",
  "description": "A demo browser assistant that analyses a local mock movie-booking page and explains whether to buy, wait, or switch shows.",
  "permissions": ["activeTab", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_title": "Open Plan my Show"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
